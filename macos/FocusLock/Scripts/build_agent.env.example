# Template for the isolated macOS build-agent account's $HOME/.otterling-build-agent/config.env.
# Copy this file there, fill in real values, and `chmod 600` it -- it holds a bearer token and a
# path to a keychain-password file, both of which must never be readable by the daily-use standard
# account on this same Mac. See RELEASE.md's "Automated macOS builds" section for the one-time
# setup this supports.

# The Linux review host, same value as filter-server/.env's UPDATE_HOST.
OTTERLING_HOST=vpn.bartholomew.help

# Narrowly-scoped bearer for POST /ci/macos-build-result + GET /ci/pending-macos-build --
# deliberately a DIFFERENT token from LOCKPROFILE_TOKEN (which every phone/Mac already carries) so
# a compromised build agent can't also impersonate a device. Generate with `openssl rand -hex 32`
# and set the SAME value in /var/lib/otterling/ci/secrets.env's MACOS_BUILD_AGENT_TOKEN on the
# Linux host.
MACOS_BUILD_AGENT_TOKEN=

# owner/repo on GitHub this agent clones from.
GITHUB_REPO=tristanmcgregor/Otterling

# Exact identity string from `security find-identity -v -p codesigning` on this account's keychain
# -- must be a real Developer ID Application identity (see RELEASE.md's one-time setup), not an
# ad-hoc or Apple Development one.
SIGNING_IDENTITY=

# A dedicated, non-login keychain created once for this purpose (NOT the account's default login
# keychain) -- e.g. `security create-keychain -p <password> /Users/<account>/Library/Keychains/otterling-build.keychain-db`,
# then import the Developer ID .p12 into it.
BUILD_KEYCHAIN_PATH=/Users/otterling-build/Library/Keychains/otterling-build.keychain-db

# chmod 600 file containing ONLY the keychain's unlock password, nothing else -- read fresh on
# every build rather than baked into this file directly, so this one file can be handled/rotated
# independently.
BUILD_KEYCHAIN_PASSWORD_FILE=/Users/otterling-build/.otterling-build-agent/keychain-password

# Optional. A `notarytool store-credentials` profile name already saved into this account's
# keychain (see `xcrun notarytool store-credentials --help`) -- if unset, notarization is skipped
# entirely and the build still ships (see build_app.sh's own doc comment on why an unnotarized
# build likely still installs fine via UpdateManager's non-quarantined download path).
NOTARY_PROFILE=
