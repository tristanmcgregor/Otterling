<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for the build agent's LaunchAGENT (not a LaunchDaemon -- see the note below), installed
  ONCE by hand at ~/Library/LaunchAgents/app.otterling.buildagent.plist for the build-agent
  account, then loaded with `launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/app.otterling.buildagent.plist`
  (no sudo -- a LaunchAgent is per-user, unlike a LaunchDaemon). See RELEASE.md's "Automated macOS
  builds" section.

  Why a LaunchAgent and not a LaunchDaemon: codesign's access to the signing keychain's private key
  depends on the calling process actually having the build-agent account's GUI/Aqua login session
  (that's what `security set-key-partition-list` grants access *within*) -- a LaunchDaemon never
  has one, regardless of its UserName key, since daemons are by design independent of any user's
  login session. Confirmed directly: the exact same unlock-keychain + codesign sequence succeeds
  when run inside that account's actual session and fails with "no identity found" from a
  LaunchDaemon, even with an otherwise-correct keychain/ACL setup. A LaunchAgent runs inside the
  session that loaded it, which is what codesign actually needs -- the same reasoning
  build_app.sh's own comments already give for why FocusLockScanner is a LaunchAgent, not a
  LaunchDaemon. The build-agent account must stay logged in (screen lock is fine, full logout is
  not) for this to keep running.

  Replace the Scripts path below with your real value before installing. This file is a template,
  not live config; nothing here is a secret.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.otterling.buildagent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/&lt;build-agent-account&gt;/otterling-checkout/macos/FocusLock/Scripts/build_agent_poll.sh</string>
    </array>
    <!-- No StartInterval: build_agent_poll.sh's GET now long-polls the server for up to ~25s
         (webhook_server.py's MACOS_LONGPOLL_SECONDS) before exiting, and KeepAlive below
         relaunches it the instant it exits -- together that behaves like one continuous poll
         loop, so a queued job gets claimed within a fraction of a second instead of up to 15
         minutes late. ThrottleInterval is launchd's own floor between relaunches (its default is
         10s); set low since the long-poll itself already paces normal operation, but still a
         safety net against a tight respawn loop if config.env is ever missing/broken. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>2</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/&lt;build-agent-account&gt;/.otterling-build-agent/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/&lt;build-agent-account&gt;/.otterling-build-agent/logs/launchd.log</string>
</dict>
</plist>
