# Copy to local.properties and keep the real key out of source control.
KNOX_LICENSE_KEY=your-development-key

# Release signing + update-pinning -- normally only ever set in CI's protected `release`
# environment secrets (see .github/workflows/update-review.yml), NOT on the daily dev machine.
# Leave these unset for ordinary local debug work; only the Guardian should ever have the real
# keystore/passwords.
# RELEASE_KEYSTORE_PATH=/path/to/release.jks
# RELEASE_KEYSTORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=
# RELEASE_CERT_SHA256=

# Android Studio normally writes this automatically.
# sdk.dir=/Users/your-name/Library/Android/sdk
