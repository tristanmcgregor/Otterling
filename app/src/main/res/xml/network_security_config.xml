<?xml version="1.0" encoding="utf-8"?>
<!--
  Only relaxes Android's default cleartext-HTTP block for the Guardian setup relay
  (GuardianSetupClient), which is a short-lived, same-Wi-Fi-only call to a home-LAN server with no
  public DNS name, so there's nothing to put a real TLS cert on. This is safe regardless: the
  payload it fetches is RSA-OAEP ciphertext end-to-end encrypted in the Guardian's browser before
  it ever reached the relay server (see server/guardian_relay.py), so plain HTTP here never
  exposes the PIN itself, only already-opaque ciphertext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
