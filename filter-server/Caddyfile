# Static host for signed Otterling update manifests/APKs + GitHub webhook reverse-proxy.
# See SELF_LOCKOUT.md. Files at /var/lib/otterling/updates; webhook on host :9070.
{
	# UDP/443 is blocked on this host (CBLOCK). Stick to TCP HTTP/1.1+2 so phones don't
	# attempt QUIC/HTTP3 and fail in confusing ways.
	servers {
		protocols h1 h2
	}
}

# Explicit IPv4 bind: without this, recent caddy:alpine often listens on :::443 only, so
# docker-proxy's IPv4 DNAT to the container gets connection-refused (phones talking A records).
{$UPDATE_HOST:vpn.bartholomew.help} {
	bind 0.0.0.0

	handle /hooks/github* {
		# network_mode: host — webhook listens on the host, not host.docker.internal.
		reverse_proxy 127.0.0.1:9070
	}
	handle_path /updates/* {
		root * /srv/updates
		file_server
	}

	# AI review dashboard (filter-server/review-dashboard/) -- read-only view of the server-side
	# release.sh pipeline's status/history, written to /var/lib/otterling/review/ (see
	# review-dashboard/README.md for the JSON schema release.sh must write). Basic-auth protected:
	# this exposes commit messages and the AI's raw review reasoning, not something to leave open
	# to the internet like /updates is. Generate the password hash with:
	#   docker run --rm caddy:alpine caddy hash-password --plaintext 'your-password-here'
	@review path /review /review/* /review-data/*
	basic_auth @review {
		{$REVIEW_DASHBOARD_USER} {$REVIEW_DASHBOARD_PASSWORD_HASH}
	}
	handle_path /review-data/* {
		root * /srv/review-data
		file_server
	}
	handle_path /review* {
		root * /srv/review-dashboard
		file_server
	}

	encode gzip
}
