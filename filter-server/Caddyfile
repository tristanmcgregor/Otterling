# Static host for signed Otterling update manifests/APKs + GitHub webhook reverse-proxy.
# See SELF_LOCKOUT.md. Files at /var/lib/otterling/updates; webhook on host :9070.
{
	# UDP/443 is blocked on this host (CBLOCK). Force HTTP/1.1 only — some Android
	# TLS stacks + HTTP/2/h3 negotiation against this Caddy build end in
	# TLSV1_ALERT_INTERNAL_ERROR on update checks.
	servers {
		protocols h1
	}
}

# Explicit IPv4 bind: without this, recent caddy:alpine often listens on :::443 only, so
# docker-proxy's IPv4 DNAT to the container gets connection-refused (phones talking A records).
{$UPDATE_HOST:vpn.bartholomew.help} {
	bind 0.0.0.0

	# Prefer the ISRG Root X1–anchored chain for Android trust-store compatibility
	# (Generation Y / YE1 short chains can fail on some phone TLS stacks).
	tls {
		issuer acme {
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}

	# Bare host with nothing else in the URL -- send guardians straight to the dashboard instead of
	# a blank/404 root. `redir`'s path match is exact, so this only fires for "/" itself.
	redir / /dashboard/ 308

	handle /hooks/github* {
		# network_mode: host — webhook listens on the host, not host.docker.internal.
		reverse_proxy 127.0.0.1:9070
	}
	handle_path /updates/* {
		root * /srv/updates
		file_server
	}

	# Lock-profile provisioning + tamper-report ingestion (see lockprofile_service.py). Its own
	# container publishes to loopback only (see docker-compose.yml); Caddy is the only path in.
	handle /lockprofile/* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /alerts/* {
		reverse_proxy 127.0.0.1:8091
	}
	# Phone-uploaded diagnostic logs (see lockprofile_service.py's module doc, DeviceLogUploader.kt).
	# The phone authenticates itself with its own LOCKPROFILE_TOKEN bearer, same as /alerts/*
	# above -- unrelated to the guardian-browser-session gate in front of /device-logs/view/*
	# below, which is for a human reading logs back, not the phone uploading them.
	handle /device-logs/upload {
		reverse_proxy 127.0.0.1:8091
	}
	# Build-provenance check-in (see IntegrityReporter.swift / lockprofile_service.py's
	# /integrity/checkin doc comment). Same bearer-token auth as /alerts/* above.
	handle /integrity/* {
		reverse_proxy 127.0.0.1:8091
	}
	# Sudo-elevation broker's AI-review fallback (see SudoBroker.swift / AIReviewClient.swift).
	# Same bearer-token auth as /alerts/* above.
	handle /sudo-review/* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /ai-assistant/* {
		reverse_proxy 127.0.0.1:8091
	}
	# Report-type enable/disable list (see report_types.json). Same bearer-token auth as /alerts/*
	# above -- ReportConfigStore.kt fetches this on the phone's existing poll cadence.
	handle /report-config {
		reverse_proxy 127.0.0.1:8091
	}

	# AI review dashboard (filter-server/review-dashboard/) -- read-only view of the server-side
	# release.sh pipeline's status/history, written to /var/lib/otterling/review/ (see
	# review-dashboard/README.md for the JSON schema release.sh must write). Also covers
	# /device-logs/view/* (uploaded phone diagnostics, see lockprofile_service.py).
	#
	# Basic Auth was removed from this whole section 2026-08-18 (stuck in an unrecoverable
	# re-prompt loop -- wrong/corrupted password hash -- and the Guardian needed this working
	# immediately) and never re-gated afterward, leaving the AI review pipeline's own
	# vulnerability-history writeups and uploaded phone diagnostic logs unauthenticated to the
	# open internet. Re-gated here the same way /dashboard's own Basic Auth got replaced one day
	# later (2026-08-19, see below) -- a custom login page + session cookie, since the native
	# browser credentials dialog was the actual thing causing re-prompt loops, not Basic Auth's
	# concept in general. Deliberately its own separate REVIEW_LOGIN_PASSWORD/session cookie (see
	# lockprofile_service.py's _handle_review_login/_handle_review_verify), not the dashboard's,
	# so dashboard and review access can be handed out independently.
	handle /review-auth/* {
		reverse_proxy 127.0.0.1:8091
	}
	redir /review-login /review-login/ 308
	handle_path /review-login/* {
		root * /srv/review-login
		file_server
	}
	# Explicit route{} for the same reason as /dashboard-api/*'s below: mixing a bare forward_auth
	# with handle/handle_path blocks leaves their relative ordering to Caddy's own directive
	# priority sort rather than guaranteeing forward_auth runs first.
	route {
		@review path /review /review/* /review-data/* /device-logs/view/*
		forward_auth @review 127.0.0.1:8091 {
			uri /review-auth/verify
		}
		handle_path /review-data/* {
			root * /srv/review-data
			file_server
		}
		# lockprofile_service.py separately requires its own bearer token, which a browser has no
		# way to supply, so Caddy injects it here rather than exposing LOCKPROFILE_TOKEN to the
		# dashboard's static JS -- unrelated to the forward_auth session gate above, which is what
		# actually keeps this route from being open to the internet now.
		handle /device-logs/view/* {
			reverse_proxy 127.0.0.1:8091 {
				header_up Authorization "Bearer {$LOCKPROFILE_TOKEN}"
			}
		}
		handle_path /review* {
			root * /srv/review-dashboard
			file_server
		}
	}

	# Device-settings dashboard (filter-server/dashboard/, built from the Figma export) -- a
	# guardian-facing console for per-device settings (protections, blocked websites, habit rules,
	# app budgets), backed by lockprofile_service.py's /dashboard-api/* routes (see that file's
	# "Dashboard device settings" section). Own custom login (filter-server/dashboard-login/) as
	# of 2026-08-19, NOT Caddy basic_auth -- the native browser credentials dialog turned out
	# unreliable in practice (stuck re-prompt loops, stale cached failures) and got replaced
	# outright. `forward_auth` calls lockprofile_service.py's /dashboard-auth/verify on every
	# matched request; only a 2xx lets the real request through. See that file's dashboard-session
	# section for how the session cookie itself works.
	handle /dashboard-auth/* {
		reverse_proxy 127.0.0.1:8091
	}
	# Bare "/dashboard-login" (no trailing slash -- how it's typed/bookmarked in practice) needs an
	# explicit redirect: handle_path's own prefix-strip only matches "/dashboard-login/..." paths,
	# so the bare form fell through to a 404 (rendered as a blank page) without this.
	redir /dashboard-login /dashboard-login/ 308
	handle_path /dashboard-login/* {
		root * /srv/dashboard-login
		file_server
	}
	# Bare "/dashboard" (no trailing slash) needs the same explicit redirect as
	# "/dashboard-login" above -- handle_path's prefix-strip below only matches
	# "/dashboard/..." paths, so the bare form would otherwise fall through to a 404.
	redir /dashboard /dashboard/ 308
	# Deterministic top-to-bottom evaluation, not Caddy's usual directive-priority sorting --
	# needed because the bearer-passthrough check below MUST run before forward_auth, and mixing
	# a bare `forward_auth` with `handle` blocks otherwise leaves that ordering to chance.
	route {
		# Devices (phone/Mac) call a handful of specific /dashboard-api/* routes with their OWN
		# LOCKPROFILE_TOKEN bearer already attached -- these must reach the backend directly,
		# WITHOUT the browser-session forward_auth gate below, since a phone/Mac has no way to
		# hold a dashboard login session cookie. Confirmed missing 2026-08-19: every dashboard-api
		# call from a device was silently rejected 401 by forward_auth before ever reaching the
		# backend's own _authorized() bearer check -- the only reason this went unnoticed for a
		# while is that every test of these routes went straight to 127.0.0.1:8091, bypassing
		# Caddy entirely.
		#
		# Deliberately scoped to an exact path+method allowlist, NOT "any /dashboard-api/* request
		# carrying an Authorization header" (that broader form shipped once and was caught by the
		# release pipeline's AI review before publishing: LOCKPROFILE_TOKEN is embedded in shipped
		# client binaries, so the person being filtered can extract it and call ANY dashboard-api
		# route with it -- a bare "has a bearer" match would let that same token POST a new
		# Guardian PIN or PATCH this device's own settings, bypassing the guardian entirely with no
		# admin-group/passcode check). Only the specific reads/writes the phone and Mac's own
		# DashboardConfigStore/DashboardConfigSync/HabitCompletionReporter code actually make it
		# through here (see those files); every guardian-authoring route -- PIN POST, settings
		# PATCH, add/remove endpoints, device removal, poll-now -- still requires the browser
		# session cookie via forward_auth below, same as before this device bypass existed at all.
		# NOTE: /dashboard-api/pin (the raw plaintext PIN) is deliberately NOT in this GET
		# allowlist -- see GUARDIAN_PIN_PATH's comment in lockprofile_service.py. Only
		# /pin/exists (a boolean, no secret) and /pin/verify (POST, one guess in/correct-or-not
		# out) are device-reachable.
		@dashboardApiDeviceGet {
			path /dashboard-api/devices/*/settings /dashboard-api/pin/exists /dashboard-api/habits
			method GET
			header Authorization *
		}
		@dashboardApiDevicePost {
			path /dashboard-api/habits/*/complete /dashboard-api/pin/verify
			method POST
			header Authorization *
		}
		reverse_proxy @dashboardApiDeviceGet 127.0.0.1:8091
		reverse_proxy @dashboardApiDevicePost 127.0.0.1:8091

		@dashboard path /dashboard /dashboard/* /dashboard-api/*
		forward_auth @dashboard 127.0.0.1:8091 {
			uri /dashboard-auth/verify
		}
		handle /dashboard-api/* {
			reverse_proxy 127.0.0.1:8091 {
				header_up Authorization "Bearer {$LOCKPROFILE_TOKEN}"
			}
		}
		handle_path /dashboard/* {
			root * /srv/dashboard
			file_server
		}
	}

	encode gzip
}

# LAN IP has no ACME cert. Without this, Caddy's HTTP→HTTPS redirect sends browsers to
# https://192.168.0.254/ which fails TLS (Chrome often shows ERR_CONNECTION_REFUSED).
http://192.168.0.254 {
	bind 0.0.0.0

	handle /hooks/github* {
		reverse_proxy 127.0.0.1:9070
	}
	handle_path /updates/* {
		root * /srv/updates
		file_server
	}

	handle /lockprofile/* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /alerts/* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /device-logs/upload {
		reverse_proxy 127.0.0.1:8091
	}
	handle /integrity/* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /sudo-review/* {
		reverse_proxy 127.0.0.1:8091
	}
	handle /ai-assistant/* {
		reverse_proxy 127.0.0.1:8091
	}
	# Report-type enable/disable list (see report_types.json). Same bearer-token auth as /alerts/*
	# above -- ReportConfigStore.kt fetches this on the phone's existing poll cadence.
	handle /report-config {
		reverse_proxy 127.0.0.1:8091
	}

	# See the matching block in the main vhost above for why this needs the login page +
	# route{}/forward_auth wrapping (re-gating after Basic Auth's 2026-08-18 removal, never
	# replaced until now).
	handle /review-auth/* {
		reverse_proxy 127.0.0.1:8091
	}
	redir /review-login /review-login/ 308
	handle_path /review-login/* {
		root * /srv/review-login
		file_server
	}
	route {
		@review path /review /review/* /review-data/* /device-logs/view/*
		forward_auth @review 127.0.0.1:8091 {
			uri /review-auth/verify
		}
		handle_path /review-data/* {
			root * /srv/review-data
			file_server
		}
		handle /device-logs/view/* {
			reverse_proxy 127.0.0.1:8091 {
				header_up Authorization "Bearer {$LOCKPROFILE_TOKEN}"
			}
		}
		handle_path /review* {
			root * /srv/review-dashboard
			file_server
		}
	}

	handle /dashboard-auth/* {
		reverse_proxy 127.0.0.1:8091
	}
	# Bare "/dashboard-login" (no trailing slash -- how it's typed/bookmarked in practice) needs an
	# explicit redirect: handle_path's own prefix-strip only matches "/dashboard-login/..." paths,
	# so the bare form fell through to a 404 (rendered as a blank page) without this.
	redir /dashboard-login /dashboard-login/ 308
	handle_path /dashboard-login/* {
		root * /srv/dashboard-login
		file_server
	}
	redir /dashboard /dashboard/ 308
	# See the matching block in the main vhost above for why this is wrapped in an explicit
	# route{} and why the bearer-passthrough check has to run before forward_auth -- including why
	# it's a tight path+method allowlist rather than "any request with an Authorization header".
	route {
		# NOTE: /dashboard-api/pin (the raw plaintext PIN) is deliberately NOT in this GET
		# allowlist -- see GUARDIAN_PIN_PATH's comment in lockprofile_service.py. Only
		# /pin/exists (a boolean, no secret) and /pin/verify (POST, one guess in/correct-or-not
		# out) are device-reachable.
		@dashboardApiDeviceGet {
			path /dashboard-api/devices/*/settings /dashboard-api/pin/exists /dashboard-api/habits
			method GET
			header Authorization *
		}
		@dashboardApiDevicePost {
			path /dashboard-api/habits/*/complete /dashboard-api/pin/verify
			method POST
			header Authorization *
		}
		reverse_proxy @dashboardApiDeviceGet 127.0.0.1:8091
		reverse_proxy @dashboardApiDevicePost 127.0.0.1:8091

		@dashboard path /dashboard /dashboard/* /dashboard-api/*
		forward_auth @dashboard 127.0.0.1:8091 {
			uri /dashboard-auth/verify
		}
		handle /dashboard-api/* {
			reverse_proxy 127.0.0.1:8091 {
				header_up Authorization "Bearer {$LOCKPROFILE_TOKEN}"
			}
		}
		handle_path /dashboard/* {
			root * /srv/dashboard
			file_server
		}
	}

	handle {
		redir https://{$UPDATE_HOST:vpn.bartholomew.help}{uri} permanent
	}

	encode gzip
}

# Fleet vhost -- append to filter-server/Caddyfile (the otterling-updates container serves it).
# Requires a DNS A record: fleet.bartholomew.help -> 121.222.88.226 (this host's public IP).
#
# The existing Caddy runs `protocols h1` globally (HTTP/1.1 only) and UDP/443 is blocked on this
# host -- fleetd/osquery speak HTTPS over TCP, so h1 is fine. This block inherits that global
# setting. Reverse-proxies to Fleet on host loopback (Caddy is network_mode: host).

fleet.bartholomew.help {
	bind 0.0.0.0

	tls {
		issuer acme {
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}

	reverse_proxy 127.0.0.1:8412

	encode gzip
}
