# Copy to .env and adjust if the defaults conflict with something else on the host.
ADMIN_UI_PORT=3000
# Optional: bind the admin UI to a specific host IP instead of every interface (0.0.0.0) -- the
# "restrict to the phone's IP / an allowlist" mitigation README.md's Firewall section recommends,
# applied here instead of (or alongside) the host firewall. Leave unset to keep the prior
# behavior (reachable on every interface).
ADMIN_UI_BIND=
DNS_PORT=53
PROXY_PORT=8080
PROXY_USER=otterling
# Required -- mitmproxy refuses to start without this set (see docker-compose.yml). Pick something
# long and random; it's the only thing standing between an open MITM proxy and the internet.
PROXY_PASSWORD=
# Comma-separated egress IP(s) that skip proxy auth entirely -- see proxy_auth_gate.py. Set this to
# the household's own public IP if you route a Mac's system-wide traffic through this proxy
# (macos/FocusLock ProxyEnforcer.swift); leave blank otherwise (auth required for everyone, safe
# default).
PROXY_AUTH_EXEMPT_IPS=
# Public hostname Caddy requests a Let's Encrypt cert for and serves /updates on -- must match
# what's configured in the Otterling app (same host as the DNS/proxy filter settings) and what
# CI's UPDATE_HOST secret publishes to.
UPDATE_HOST=vpn.bartholomew.help

# One shared Guardian PIN, gating BOTH the device-settings dashboard at /dashboard (see
# filter-server/dashboard/README.md) and the AI review dashboard at /review (see
# review-dashboard/README.md), in addition to gating Settings on the phone itself. Own custom
# login pages (filter-server/dashboard-login/, filter-server/review-login/), NOT Caddy Basic Auth
# -- lockprofile_service.py checks this directly (see its GUARDIAN_PIN_PATH comment), so it's the
# PLAINTEXT PIN, not a hash. Must be exactly 4 digits or it's ignored. This env var is only a
# bootstrap default for a brand-new deployment with no PIN set yet -- once a guardian sets a real
# PIN from the dashboard's own Global Settings screen, that's stored in guardian_pin.json and
# always wins from then on, so this var only matters for the very first login.
GUARDIAN_PIN=

# Auth for the macOS lock-profile service (lockprofile_service.py) -- provisioning and tamper-alert
# ingestion both require this as a Bearer token. Generate with: openssl rand -hex 32
# See macos/FocusLock/GUARDIAN_SETUP.md §6 for what this profile does and doesn't protect against.
LOCKPROFILE_TOKEN=
LOCKPROFILE_PORT=8091

# Optional: pushes every tamper event to the accountability partner's phone via ntfy.sh (free, no
# signup, no message caps -- https://ntfy.sh). Leave blank to skip notification and only log events
# to lockprofile-data/alerts/events.jsonl. Generate a private topic name with, e.g.:
#   openssl rand -hex 16
# then have the partner install the ntfy app and subscribe to that exact topic string. Treat the
# topic name as a secret -- ntfy's public server has no auth beyond "know the topic name".
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# Subscription OAuth token (`claude setup-token`, NOT an API key) for the on-device `claude -p`
# calls ai_classifier.py/nsfw_image_classifier.py make from the mitmproxy, dns-classifier, and
# lockprofile containers -- see ai_classifier.py's module docstring for why a subscription token
# instead of a metered ANTHROPIC_API_KEY. Each of these three tiers fails open (no block) if unset.
CLAUDE_CODE_OAUTH_TOKEN=
# Optional: a second subscription's token. If the primary account above hits its own usage/session
# limit (surfaces as `claude -p` exiting non-zero, same as any other failure), one retry is made
# against this token before the call gives up and fails open -- see
# ai_classifier.py's _run_claude_with_fallback. Leave blank for the old single-token behavior.
CLAUDE_CODE_OAUTH_TOKEN_BACKUP=

# onnx_nsfw_pipeline.py: two-stage Falconsai/NudeNet ONNX classifier that nsfw_image_classifier.py
# tries before its `claude -p` fallback. Inert until you drop converted .onnx files into
# filter-server/models/ (see that module's "Bringing your own models" doc for exact requirements) --
# leave everything below blank until then. Once models are in place, set MODEL_VERSION to a content
# hash or HF commit SHA (never leave it "unpinned" in production, per section 12 of the plan) and
# calibrate the thresholds against your own locked screenshot benchmark (section 7/8) before
# trusting this path -- the defaults are placeholders, not measured values.
NSFW_STAGE1_MODEL_VERSION=
NSFW_STAGE2_MODEL_VERSION=
NSFW_POLICY_VERSION=v1
NSFW_HIGH_RISK_THRESHOLD=0.9
NSFW_REVIEW_THRESHOLD=0.5
NSFW_STAGE2_CONFIDENCE_THRESHOLD=0.6
