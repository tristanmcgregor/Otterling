# Copy to .env and adjust if the defaults conflict with something else on the host.
ADMIN_UI_PORT=3000
DNS_PORT=53
PROXY_PORT=8080
PROXY_USER=otterling
# Required -- mitmproxy refuses to start without this set (see docker-compose.yml). Pick something
# long and random; it's the only thing standing between an open MITM proxy and the internet.
PROXY_PASSWORD=
# Public hostname Caddy requests a Let's Encrypt cert for and serves /updates on -- must match
# what's configured in the Otterling app (same host as the DNS/proxy filter settings) and what
# CI's UPDATE_HOST secret publishes to.
UPDATE_HOST=vpn.bartholomew.help

# HTTP Basic Auth for the AI review dashboard at /review -- see review-dashboard/README.md.
# Required -- Caddy refuses to start without REVIEW_DASHBOARD_PASSWORD_HASH set. Generate it with:
#   docker run --rm caddy:alpine caddy hash-password --plaintext 'your-password-here'
# Paste the bcrypt hash it prints (starts with $2a$ or $2b$) below -- never the plaintext password.
REVIEW_DASHBOARD_USER=guardian
REVIEW_DASHBOARD_PASSWORD_HASH=
